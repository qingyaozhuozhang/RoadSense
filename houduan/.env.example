# RoadSense houduan / 树莓派边缘设备
# 已与 qianduan/.env 配对；包含相同设备令牌和高德 Web JS 配置。
# 保密：禁止将此文件提交 GitHub/Gitee。

# 阿里云目前为 HTTP 5000；启用 HTTPS 后同步调整 URL
CLOUD_BASE_URL=http://YOUR_SERVER_IP:5000
DEVICE_TOKEN=

AMAP_JS_KEY=
AMAP_JS_SECRET=

# 摄像头及 YOLOv8-OBB 识别
CAMERA_INDEX=2
CAMERA_SCAN_INTERVAL=5
YOLO_MODEL=best.onnx
SAVE_DIR=severe_cracks
ORT_PROVIDER=cpu
ORT_THREADS=2

# 视频传输参数：保持原版的较流畅模式
VIDEO_RENDER_FPS=25
VIDEO_UPLOAD_FPS=20
VIDEO_UPLOAD_CONCURRENCY=4
VIDEO_JPEG_QUALITY=50
VIDEO_OUTPUT_WIDTH=640
DIRECT_VIDEO_ENABLED=1
DIRECT_VIDEO_BIND=127.0.0.1
DIRECT_VIDEO_PORT=8091

# 用户新 GPS：u-blox NEO-F10N，经 TX/RX 连接树莓派 GPIO UART
# 默认 UART 38400 8N1；/dev/serial0 需已启用并且未被串口控制台占用。
# 如果实际模块重新配置过波特率，需同步修改 GPS_BAUD。
GPS_PORT=/dev/serial0
GPS_BAUD=38400

# 局域网 IP 未知，PI_LAN_HOST 不手填假地址；程序自动识别实际 IP。
# 证书需由手机信任；未提供可信证书时可能影响浏览器 GPS。

# Leave empty to auto-detect LAN IPv4; old browser mobile access is not used by native Android.
PI_LAN_HOST=

# Leave empty unless the public direct-video host is known and reachable.
DIRECT_VIDEO_PUBLIC_HOST=

# Optional trusted Pi HTTPS certificate path (not supplied). Not needed for native app.
PI_SSL_CERT_FILE=

# Optional matching HTTPS private key path (not supplied). Not needed for native app.
PI_SSL_KEY_FILE=

# Unique device identity; for additional Pi, create separate ID/token in admin UI.
DEVICE_ID=pi-main
