# RoadSense qianduan / 阿里云 Flask 服务
# 适配 Android RoadSense App、扫码网页版、树莓派 houduan
# 保密：包含高德 JS 密钥、设备通信令牌和 Session 签名密钥；禁止上传 Git 仓库。
# 阿里云部署目录：/home/admin/RoadSense/qianduan

# Flask 服务绑定；云端端口与 Android 内置地址保持一致
HOST=0.0.0.0
PORT=5000

# 高德 Web JS API（用户之前配置的 RoadSense-Map）
AMAP_JS_KEY=f971de65e2b119cfb220878d1cbb38a1
AMAP_JS_SECRET=fd9d33fd3c0876be8213a720fe20ce95

# 树莓派 ↔ 阿里云设备通信凭据：沿用上一版同一个令牌
DEVICE_TOKEN=49a26ab331c0a5cde91e986e12540fd0eccd94c90e8ba0242f13b21145d2ae29

# 登录/会话；此项生成一次后保持不变；更新会使旧登录 Cookie 失效但不影响账号数据库
ROADSENSE_SECRET_KEY=7995f034e57a2235327085830d6816efe5f51ac5fd5b93dd79221f625cbc615b
REGISTRATION_ENABLED=1

# 目前云端仍是 HTTP（仅供调试）。迁移可信 HTTPS 后改为 1
SESSION_COOKIE_SECURE=0

# 数据和 ONNX 模型完整路径，对应当前阿里云 qianduan 目录
ROADSENSE_DATA_DIR=/home/admin/RoadSense/qianduan/data
PHONE_YOLO_MODEL=/home/admin/RoadSense/qianduan/models/best.onnx
MAX_PHONE_ACCURACY_M=500

# 不要为 PHONE_PUBLIC_URL 填 http:// 公网地址：二维码浏览器 GPS 需可信 HTTPS。
# 保持未设置时系统会优先使用树莓派通过心跳报告的 https://局域网IP:8080/phone。
# 今后给云端配置可信域名后可加入，例如 PHONE_PUBLIC_URL=https://example.com/phone
# CONTROL_TOKEN 可选；当前网页控制使用账号登录和 CSRF，勿随意添加而导致控制指令被拒绝。

# Optional extra password for /api/control; empty keeps existing logged-in + CSRF operation.
CONTROL_TOKEN=

# Legacy QR browser endpoint is disabled in UI. Native Android uses CLOUD_BASE_URL directly.
PHONE_PUBLIC_URL=

# Optional local hostname for retired browser mobile entry; left empty intentionally.
LAN_HOST=

# No SSL certificate supplied; use a reverse proxy with a trusted HTTPS certificate for production.
SSL_CERT_FILE=

# No SSL key supplied; use reverse proxy TLS configuration, do not invent a path.
SSL_KEY_FILE=

# 云端接收频率由边缘设备上传速率、HTTP并发、实际网络与服务器性能决定。
# VIDEO_UPLOAD_CONCURRENCY 在 houduan/.env 配置；qianduan 不限制云端固定为 5 FPS。

# Multi-device enrollment: initial device uses existing DEVICE_TOKEN; later add via /admin.
BOOTSTRAP_DEVICE_ID=pi-main
# Never enable weak legacy token-only auth in a multi-user deployment.
ALLOW_LEGACY_DEVICE_AUTH=0

# Downloaded houduan/.env will connect over HTTP; HTTPS not enabled yet.
DEVICE_CLOUD_BASE_URL=http://39.102.84.218:5000

# 当前使用 HTTP 5000，未配置可信 HTTPS 反向代理。
ROADSENSE_TRUST_PROXY=0
