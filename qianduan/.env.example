# Copy to .env on the cloud server; never commit .env
HOST=0.0.0.0
PORT=5000
# Enable TLS before opening login to an untrusted/public network.
SESSION_COOKIE_SECURE=0
REGISTRATION_ENABLED=1
ROADSENSE_TRUST_PROXY=0
# Used only when a trusted reverse proxy is configured

AMAP_JS_KEY=
AMAP_JS_SECRET=
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
DEVICE_TOKEN=
ROADSENSE_SECRET_KEY=
CONTROL_TOKEN=
BOOTSTRAP_DEVICE_ID=pi-main
ALLOW_LEGACY_DEVICE_AUTH=0

# Public address to embed in newly downloaded device .env files
DEVICE_CLOUD_BASE_URL=http://YOUR_SERVER_IP:5000
# ROADSENSE_DATA_DIR=/absolute/path/to/private/data
# PHONE_YOLO_MODEL=/absolute/path/to/qianduan/models/best.onnx
MAX_PHONE_ACCURACY_M=500
PHONE_PUBLIC_URL=
LAN_HOST=
SSL_CERT_FILE=
SSL_KEY_FILE=
